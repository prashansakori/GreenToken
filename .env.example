# GreenToken frontend uses public Stellar Testnet endpoints only.
VITE_STELLAR_NETWORK=testnet

# Public Soroban contract address. Set after deploying GreenToken to Testnet.
VITE_GREEN_TOKEN_CONTRACT_ID=

# Optional public, funded Testnet account used only to simulate read-only contract calls
# when no wallet is connected. A connected wallet takes precedence. This is not a secret.
VITE_GREEN_TOKEN_READ_ACCOUNT=

# Never put Stellar secret keys, seed phrases, private keys, or signing secrets
# in VITE_* variables. Vite embeds VITE_* values in the browser bundle.
